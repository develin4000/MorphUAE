kickstart_rom_file=kick.rom

# cpu settings
cpu_type=68020
cpu_speed=real
#cpu_speed=max
#cpu_compatible=false
#cpu_cycle_exact=true
floppy_speed=1000

# chipset settings
chipset=aga
immediate_blits=true
#fast_copper=true
#collision_level=full
#blitter_cycle_exact=false

# memory settings
fastmem_size=4
chipmem_size=2
z3mem_size=16

# gfx settings
#gfx_width=320
#gfx_height=256
#gfx_width_windowed=320
#gfx_height_windowed=256
#gfx_width_fullscreen=320
#gfx_height_fullscreen=256
#gfx_linemode=none
#gfx_lores=true

#gfx_width=640
#gfx_height=512
#gfx_width_windowed=640
#gfx_height_windowed=512
#gfx_width_fullscreen=640
#gfx_height_fullscreen=512
#gfx_lores=false
#gfx_linemode=double

##gfx_colour_mode=8bit
#double, none, scanlines
#gfx_center_horizontal=true
#gfx_center_vertical=true
#gfx_fullscreen_amiga=true
#gfxcard_size=4
#gfx_fullscreen_picasso=false
#gfx_vsync=true
#show_leds=true
#gfxcard_size=32

# sound settings (sound_output="normal" or "none")
#                (sound_channels="stereo or "mono" or "mixed")
#                (sound_bits="8" or "16")

sound_output=normal
#sound_bits=16
sound_channels=stereo
sound_frequency=44100

# joy <n> where n is lowlevel unit in amigaos target. In SDL target it's be the enumeration order.
joyport0=mouse
joyport1=joy1


